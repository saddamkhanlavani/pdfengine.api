{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Stripe": {
    "SecretKey": "sk_test_your_key",
    "WebhookSecret": "whsec_your_secret"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=pdfengine;Username=pdfuser;Password=pdfpassword"
  },
  "PdfEngine": {
    "TimeoutSeconds": 30,
    "MaxHtmlLength": 2000000,
    "MaxConcurrentRenders": 2,
    "EnableDetailedErrors": true
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "AWS": {
    "Profile": "default",
    "Region": "us-east-1",
    "ServiceURL": "http://localhost:9000",
    "BucketName": "pdf-storage",
    "ForcePathStyle": true
  },
  "Jwt": {
    "Key": "***PURGED-ROTATED-SECRET***",
    "Issuer": "PdfEngine",
    "Audience": "PdfEngineUI"
  }
}